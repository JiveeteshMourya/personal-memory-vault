# Copy to .env.local and fill in the values. Never commit .env.local.
# Every env var the app reads is validated in src/lib/env.ts; each phase that adds one
# appends it there and here.

# Postgres (Phase 02).
# Local dev: both point at the docker-compose database (`docker compose up -d`).
# Hosted Supabase: DATABASE_URL is the transaction pooler (port 6543), DIRECT_URL the direct
# connection (port 5432). The app reads DATABASE_URL; drizzle-kit (migrations, studio) reads DIRECT_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memory_vault
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/memory_vault
