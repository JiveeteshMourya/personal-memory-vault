# Copy to .env.local and fill in the values. Never commit .env.local.
# Every env var the app reads is validated in src/server/lib/env.ts.

# Postgres: the docker-compose database (`docker compose up -d`). The app and drizzle-kit
# (migrations, studio) both read DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memory_vault

# Better Auth.
# BETTER_AUTH_SECRET: at least 32 characters. Generate one with `bunx auth@latest secret` or
# `openssl rand -base64 32`. Changing it signs everyone out.
# BETTER_AUTH_URL: the app's public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Memory encryption.
# MEMORY_ENCRYPTION_KEY: 32 random bytes, base64. Memory content is encrypted with it (AES-256-GCM)
# before it reaches the database. Generate one with `openssl rand -base64 32` or
# `bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Changing or losing it makes every stored memory unreadable.
MEMORY_ENCRYPTION_KEY=

# AI. One OpenAI key covers memory extraction and embeddings.
# OPENAI_MODEL: a small, fast model for extraction (default gpt-6-luna). Any current reasoning model
# with Structured Outputs works.
# OPENAI_EMBEDDING_MODEL: must support 1536 dimensions (default text-embedding-3-small).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Semantic index: Qdrant, started with Postgres by `docker compose up -d`.
# The collection is created on first use (1536 dimensions, cosine). It holds only vectors and
# non-content labels; memory content never leaves Postgres. Vectors persist in the `qdrant_data`
# volume. `bun run reindex` rebuilds the index from Postgres (after seeding, or to repair drift).
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=memories
