# Copy to .env.local and fill in the values. Never commit .env.local.
# Every env var the app reads is validated in src/lib/env.ts; each phase that adds one
# appends it there and here.

# Postgres (Phase 02).
# Local dev: both point at the docker-compose database (`docker compose up -d`).
# Hosted Supabase: DATABASE_URL is the transaction pooler (port 6543), DIRECT_URL the direct
# connection (port 5432). The app reads DATABASE_URL; drizzle-kit (migrations, studio) reads DIRECT_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memory_vault
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/memory_vault

# Better Auth (Phase 03).
# BETTER_AUTH_SECRET: at least 32 characters. Generate one with `bunx auth@latest secret` or
# `openssl rand -base64 32`. Changing it signs everyone out.
# BETTER_AUTH_URL: the app's public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Memory encryption (Phase 04).
# MEMORY_ENCRYPTION_KEY: 32 random bytes, base64. Memory content is encrypted with it (AES-256-GCM)
# before it reaches the database. Generate one with `openssl rand -base64 32` or
# `bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Changing or losing it makes every stored memory unreadable.
MEMORY_ENCRYPTION_KEY=
